# Install as /etc/aegis/api.env, readable by the API service only. Never commit real values.
AEGIS_ENV=production
DATABASE_URL=postgresql+psycopg://aegis:REPLACE@127.0.0.1:5432/aegis
REDIS_URL=redis://127.0.0.1:6379/0
WEB_ORIGIN=https://security.example.com
COOKIE_SECURE=true
LOCAL_FIXTURE_MODE=false
PAYMENTS_ENABLED=false
PRICING_ENABLED=false
PADDLE_ENABLED=false
INSTAPAY_ENABLED=false
AI_ASSISTANT_ENABLED=false
BILLING_MODE=disabled
DEMO_ACCESS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=security@example.com
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=aegis-d034c
FIREBASE_WEB_API_KEY=AIzaSyBesgBKfagXXziUQf1jTxk_Jbc5JHF06bk
FIREBASE_WEB_APP_ID=1:253957180418:web:17aa8f974057d58feeeb1b
GOOGLE_APPLICATION_CREDENTIALS=/etc/aegis/firebase-identity.json

# Generate a Fernet key on the server; keep private and back up securely.
MFA_ENCRYPTION_KEY=

# Optional model-assisted effort advice; leave disabled for free deterministic operation.
# Backend only; do not put a provider credential in frontend environment variables.
AI_PROVIDER_ENABLED=false
AI_CHAT_ENDPOINT=
AI_MODEL=
AI_API_KEY=
