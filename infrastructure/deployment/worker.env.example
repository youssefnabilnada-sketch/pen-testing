# Copy for scanner.env, intelligence.env and scheduler.env. No SMTP, Firebase or MFA secrets here.
AEGIS_ENV=production
DATABASE_URL=postgresql+psycopg://aegis:REPLACE@127.0.0.1:5432/aegis
REDIS_URL=redis://127.0.0.1:6379/0
WEB_ORIGIN=https://security.example.com
COOKIE_SECURE=true
LOCAL_FIXTURE_MODE=false
PAYMENTS_ENABLED=false
BILLING_MODE=disabled
# A dedicated notifier worker has its own notifier.env and notifications queue.
