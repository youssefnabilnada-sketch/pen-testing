# Copy to /etc/aegis/notifier.env (root:aegis-notifier, 0640).
# Alert SMTP is restricted to the dedicated notifications worker.
AEGIS_ENV=production
DATABASE_URL=postgresql+psycopg://aegis:REPLACE@127.0.0.1:5432/aegis
REDIS_URL=redis://127.0.0.1:6379/0
WEB_ORIGIN=https://security.example.com
COOKIE_SECURE=true
LOCAL_FIXTURE_MODE=false
PAYMENTS_ENABLED=false
PRICING_ENABLED=false
PADDLE_ENABLED=false
INSTAPAY_ENABLED=false
AI_ASSISTANT_ENABLED=false
AI_PROVIDER_ENABLED=false
BILLING_MODE=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=security@example.com
# Do NOT copy Firebase admin credentials, MFA key or scanner target credentials here.
