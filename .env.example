# Local development only. Set a long random database password before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
LOCAL_FIXTURE_MODE=true
PAYMENTS_ENABLED=false
PRICING_ENABLED=false
PADDLE_ENABLED=false
INSTAPAY_ENABLED=false
BILLING_MODE=disabled
DEMO_ACCESS_ENABLED=true
AI_ASSISTANT_ENABLED=false

# Optional identity only; never grants domain ownership or production write access.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Use a server-side mounted credential or workload identity. Never commit service-account JSON.
# Public browser app configuration (not service-account credentials).
FIREBASE_WEB_API_KEY=AIzaSyBesgBKfagXXziUQf1jTxk_Jbc5JHF06bk
FIREBASE_WEB_APP_ID=
# Required only by the optional Firebase Compose overlay; keep file outside repo.
FIREBASE_CREDENTIAL_FILE=

# Optional model-assisted effort estimates. No provider is required for operation.
AI_PROVIDER_ENABLED=false
AI_CHAT_ENDPOINT=
AI_MODEL=
AI_API_KEY=

# GitHub App: contents read/write, pull requests read/write, checks read.
# Install only on selected repositories. User authorization is also required.
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# Generate a separate Fernet key; never commit private values.
GITHUB_TOKEN_KEY=
